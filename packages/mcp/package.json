{
  "name": "@sigilkit/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing SigilKit to agent frameworks: zero-gas request validation, scope building, revert decoding, and audit queries.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "sigilkit-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@sigilkit/core": "^0.1.0",
    "@sigilkit/indexer": "^0.1.0",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev25bansal-ops/sigilkit.git"
  }
}
