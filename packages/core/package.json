{
  "name": "@sigilkit/core",
  "version": "0.1.0",
  "description": "SigilKit core SDK: EIP-712 typed action requests and session-key management for agent-native wallets.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lease-fs": {
      "types": "./dist/lease-fs.d.ts",
      "default": "./dist/lease-fs.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit && tsc -p tsconfig.wallet-e2e.json --noEmit"
  },
  "dependencies": {
    "viem": "^2.56.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.0",
    "ethers": "^6.17.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigilkit/sigilkit.git"
  }
}
