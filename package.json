{
  "name": "sigilkit",
  "version": "0.1.0",
  "description": "Open-source toolkit for agent-native wallets: EIP-7702 library, session-key manager with on-chain spend caps and mandatory audit events.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/bootstrap.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "build": "npm run build --workspaces --if-present",
    "test": "forge test --no-match-contract '.*Invariant|.*Fork' && npm run test --workspaces --if-present",
    "test:full": "forge test --no-match-contract '.*Fork' && npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "npm run lint:workflows && npm run lint:docker && npm run lint --workspaces --if-present",
    "lint:workflows": "node scripts/validate-workflows.mjs",
    "lint:docker": "node scripts/check-dockerfile.mjs",
    "check:docs": "node scripts/check-doc-counts.mjs",
    "check:docs:full": "node scripts/check-doc-counts.mjs --with-ts",
    "clean": "node scripts/clean.mjs",
    "vectors:generate": "node scripts/generate-vectors.mjs",
    "demo": "npm run demo --workspace @sigilkit/demo-agent --",
    "fleet": "npm run fleet --workspace @sigilkit/demo-agent --",
    "mcp": "npm run start --workspace @sigilkit/mcp --"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
