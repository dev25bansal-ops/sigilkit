# CI tool binaries and their tarballs. `scripts/install-actionlint.sh` and
# `scripts/install-gitleaks.sh` now extract into $RUNNER_TEMP (or outputs/ locally), so these
# should never appear in a working tree — but an older local checkout, or a run of the script
# from the repo root, can still leave them behind, and `gitleaks` alone is ~40MB. Ignoring
# them keeps a stray `git add -A` from committing a large binary.
gitleaks
gitleaks.tar.gz
actionlint
actionlint.tar.gz

# Assistant-worknote dirs, not project deliverables
.workbuddy-ai/
agents/

