# Dependencies
node_modules/
.pnpm-store/

# Foundry / Solidity build artifacts
out/
cache/
broadcast/
lib/forge-std/  # installed via submodule/clone at build time

# Env / secrets
.env
.env.local
*.key

# Local assistant-tool configuration (SK-01): models.json carries populated
# credential fields and must never be committed. The .codebuddy/ folder itself
# stays available for project data — only the credential file is excluded.
.codebuddy/models.json

# Obsidian
.vault/.obsidian/workspace.json

# Editor
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# Coverage
coverage/

# Build output
dist/

# Session tooling
.claude/

# Vault workspace state (keep notes, ignore Obsidian internals)
vault/.obsidian/

# Wallet E2E harness (downloaded MetaMask extension + Playwright profile). `metamask*/`
# covers the active pin plus any versioned copy kept side-by-side for a rollback.
packages/core/test/wallet-e2e/metamask*/
packages/core/test/wallet-e2e/metamask*.zip
packages/core/test/wallet-e2e/.playwright-profile/
packages/core/test/wallet-e2e/.coinbase-out/
packages/core/test-results/

# Harness/verification scratch — may contain profiles and credential-adjacent logs (SK-01)
outputs/
crytic-export/
actionlint.exe

# Assistant-worknote dirs, not project deliverables
.workbuddy-ai/
agents/

# Session tooling state
.freebuff/

# Logs
*.log

# Generated artifacts (CQ-6). The whitepaper's source of truth is
# docs/WHITEPAPER-v2.1.md plus SigilKit_Whitepaper.txt — both plain text, both diffable.
# The PDF is a derived export and was a 1.5 MB binary in history with no diff value;
# keep it on disk locally, regenerate it for a release, attach it to the release.
SigilKit_Whitepaper.pdf
fleet-manifest.json

# Local audit stores. The indexer's default output is ./sigilkit-audit.db, so a stray
# `sigilkit-indexer backfill` would otherwise show up as an untracked binary.
*.db
*.db-shm
*.db-wal

# Docker compose local state
data/
