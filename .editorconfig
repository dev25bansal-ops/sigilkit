# EditorConfig — https://editorconfig.org
# Keeps line endings and indentation identical across editors so that the ABI
# byte-diff gate (packages/core/abis) and the golden-vector files stay stable.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sol]
indent_size = 4
max_line_length = 120

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
# Trailing spaces are significant in Markdown (hard line breaks).
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
