# SigilKit — environment reference
#
# Copy to `.env` and edit. `.env` is gitignored; this file is the documented contract.
#   cp .env.example .env
#
# Every CLI loads `.env` (then `.env.local`) from the working directory at startup, so the
# copy above is all a local run needs. A real environment variable always wins over the file,
# which is how CI and containers override it without editing anything.
#
# Most values have a working default. The exceptions are the fail-closed ones below,
# which have none: SIGILKIT_AUDIT_DB_ROOT (unset => MCP audit_query refuses every path)
# and SIGILKIT_OWNER_ADDRESS / SIGILKIT_CREATE2_SALT (required by the deploy scripts).
#
# Reference docs: docs/CONFIGURATION.md

# ─── Runtime (demo agent, fleet demo) ─────────────────────────────────────────────
# JSON-RPC endpoint the demo agent and fleet demo talk to.
# Default: http://127.0.0.1:8545  (a local `anvil`)
SIGILKIT_RPC_URL=http://127.0.0.1:8545

# Chain id used when signing and submitting. 31337 is the Anvil/Foundry default.
# Default: 31337
SIGILKIT_CHAIN_ID=31337

# Owner (wallet) private key — 0x + 64 hex chars.
# Default (demo agent only): Anvil account #0, public development key; never put a
# funded key here. The Foundry deploy scripts have NO default — Deploy.s.sol and
# DeployDeterministic.s.sol call vm.envUint("SIGILKIT_OWNER_KEY") and REVERT when unset.
SIGILKIT_OWNER_KEY=

# Agent (session-key holder) private key — 0x + 64 hex chars.
# Default: Anvil account #1 (public development key).
SIGILKIT_AGENT_KEY=

# Relayer (gas-only) private key — 0x + 64 hex chars. Pays gas for already-signed
# calldata; holds no authority over the manager.
# Default: a gas-only key derived from a public constant inside
# packages/demo-agent/src/devkeys.ts:52 — NOT an Anvil account.
SIGILKIT_RELAYER_KEY=

# Opt-in for the owner-side half of `npm run demo` (deploy + fund + grantSessionKey).
# Without it only the agent loop runs.
# Default: unset (owner side skipped) — same effect as passing `--grant`.
SIGILKIT_DEMO_GRANT=

# ─── Toolchain paths ──────────────────────────────────────────────────────────────
# Absolute path to the `forge` binary. Only needed when Foundry is not on PATH.
# Default: $HOME/.foundry/bin/forge
FORGE_BIN=

# Absolute path to the `anvil` binary. Only needed when Foundry is not on PATH.
# Default: $HOME/.foundry/bin/anvil
ANVIL_BIN=

# ─── Deploy scripts (Foundry `forge script`) ────────────────────────────────────
# Address that will own the deployed SessionKeyManager. PRODUCTION: a governance
# contract (e.g. a 2-of-3 Safe). Read as vm.envOr("SIGILKIT_OWNER_ADDRESS", address(0));
# DeployDeterministic.s.sol REVERTS when it is unset, Deploy.s.sol falls back to the
# broadcaster EOA (local/test only). See SECURITY.md, "Key-handling statement".
# Default: unset
SIGILKIT_OWNER_ADDRESS=

# CREATE2 salt for the deterministic deploy, so the same owner yields the same address
# on every chain. Must be non-zero or DeployDeterministic.s.sol reverts.
# Default: unset (read only by contracts/script/DeployDeterministic.s.sol)
SIGILKIT_CREATE2_SALT=

# ─── Indexer / MCP services ───────────────────────────────────────────────────────
# SQLite file the indexer writes and the MCP audit_query tool reads.
# Default: ./sigilkit-audit.db
SIGILKIT_DB_PATH=./sigilkit-audit.db

# Directory roots the MCP server may open a database under. `;`-separated list of
# ABSOLUTE directories; relative entries are dropped with a warning. Read once at
# startup. While this is unset the MCP `audit_query` tool refuses EVERY path, so it is
# inert — the refusal surfaces as a database-not-found error, not a "not configured" one.
# (packages/mcp/src/server.ts readAuditDbRoots / resolveAuditDbPath.)
# Default: unset => audit_query disabled
SIGILKIT_AUDIT_DB_ROOT=

# SessionKeyManager address to index (used by `sigilkit-indexer backfill|watch`).
# No default — backfill and watch require it (via this variable or --manager).
SIGILKIT_MANAGER=

# Chain id the indexer indexes by default.
# Default: falls back to SIGILKIT_CHAIN_ID, then 31337
SIGILKIT_INDEXER_CHAIN_ID=31337

# Blocks to stay behind the chain head, so a reorg cannot land in the index.
# Default: 12  (use 0 on local/dev chains, where the head is near genesis)
SIGILKIT_CONFIRMATIONS=12

# Maximum block span per eth_getLogs call; larger ranges are chunked.
# Default: 2000
SIGILKIT_MAX_BLOCK_RANGE=2000

# ─── Optional: fork tests ─────────────────────────────────────────────────────────
# Archive RPC URL for the nightly Base fork smoke test. Unset => the job skips
# cleanly instead of failing.
RPC_BASE=

# ─── Optional: wallet conformance harness ─────────────────────────────────────────
# Set to 1 to run the Playwright + MetaMask harness (slow; needs a browser).
# Default: unset (harness skipped)
RUN_WALLET_E2E=

# Port for the local test dapp the harness drives.
# Default: 8765
WALLET_DAPP_PORT=8765

# URL the harness opens for the test dapp.
# Default: http://127.0.0.1:8765/dapp.html
DAPP_URL=http://127.0.0.1:8765/dapp.html

# ─── Optional: log verbosity ──────────────────────────────────────────────────────
# debug | info | warn | error | silent
# Default: info
SIGILKIT_LOG_LEVEL=info

# text (human) | json (one object per line, for a log collector)
# Default: text
SIGILKIT_LOG_FORMAT=text
